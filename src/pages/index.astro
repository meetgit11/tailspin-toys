---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length > 0 && (
        <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg" data-testid="game-filters">
          <div class="grid gap-4 md:grid-cols-2">
            <fieldset class="space-y-3" data-testid="category-filter-group">
              <legend class="text-sm font-medium text-slate-200">Categories</legend>
              <div class="flex flex-wrap gap-2">
                {categories.map((category) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none">
                    <input
                      type="checkbox"
                      value={category.id}
                      data-filter-group="category"
                      data-testid="category-filter"
                      class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-blue-500"
                    />
                    <span>{category.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <fieldset class="space-y-3" data-testid="publisher-filter-group">
              <legend class="text-sm font-medium text-slate-200">Publishers</legend>
              <div class="flex flex-wrap gap-2">
                {publishers.map((publisher) => (
                  <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-600 bg-slate-900/60 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-purple-500 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none">
                    <input
                      type="checkbox"
                      value={publisher.id}
                      data-filter-group="publisher"
                      data-testid="publisher-filter"
                      class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-purple-500 focus:ring-purple-500"
                    />
                    <span>{publisher.name}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          </div>

          <p class="mt-4 text-sm text-slate-300" data-testid="filter-results-count" aria-live="polite">
            Showing {games.length} of {games.length} games
          </p>
        </div>
      )}

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid" id="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div data-testid="filtered-empty-state" hidden class="mt-4">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryInputs = [...document.querySelectorAll<HTMLInputElement>('[data-filter-group="category"]')];
  const publisherInputs = [...document.querySelectorAll<HTMLInputElement>('[data-filter-group="publisher"]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const resultsCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  function updateVisibleGames() {
    const selectedCategories = new Set(categoryInputs.filter((input) => input.checked).map((input) => Number(input.value)));
    const selectedPublishers = new Set(publisherInputs.filter((input) => input.checked).map((input) => Number(input.value)));

    let visibleCount = 0;

    cards.forEach((card) => {
      const categoryId = card.dataset.categoryId ?? 'none';
      const publisherId = card.dataset.publisherId ?? 'none';

      const matchesCategory = selectedCategories.size === 0 || (categoryId !== 'none' && selectedCategories.has(Number(categoryId)));
      const matchesPublisher = selectedPublishers.size === 0 || (publisherId !== 'none' && selectedPublishers.has(Number(publisherId)));
      const shouldShow = matchesCategory && matchesPublisher;

      card.hidden = !shouldShow;
      if (shouldShow) {
        visibleCount += 1;
      }
    });

    if (gamesGrid) {
      gamesGrid.hidden = visibleCount === 0;
    }

    if (emptyState) {
      emptyState.hidden = visibleCount !== 0;
    }

    if (resultsCount) {
      const totalGames = cards.length;
      const label = visibleCount === 1 ? 'game' : 'games';
      resultsCount.textContent = `Showing ${visibleCount} of ${totalGames} ${label}`;
    }
  }

  [...categoryInputs, ...publisherInputs].forEach((input) => {
    input.addEventListener('change', updateVisibleGames);
  });

  updateVisibleGames();
</script>
